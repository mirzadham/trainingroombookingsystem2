APP_NAME="MIMOS Academy Training Room Booking System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kuala_Lumpur
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (MySQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=training_room_booking
DB_USERNAME=root
DB_PASSWORD=

# Session & Cache Settings
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database

# Mail Settings (Use 'log' for local dev)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@mimos.my"
MAIL_FROM_NAME="${APP_NAME}"

# Sanctum API & Frontend URL
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:8000,127.0.0.1:8000
FRONTEND_URL=http://localhost:5173

# Booking Reminders & Pending Expiry (scheduled jobs — see docs/SETUP_GUIDE.md §7)
# Hours before a booking starts that reminder emails are sent (daily/hourly job).
BOOKING_REMINDER_WINDOW_HOURS=24
# Pending bookings unanswered for this many days are auto-rejected by the nightly job.
BOOKING_PENDING_EXPIRY_DAYS=7
